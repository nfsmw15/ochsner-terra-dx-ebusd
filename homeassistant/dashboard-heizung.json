         "tickAmount": 6,
         "decimalsInFloat": 0,
         "title": {
          "text": "Vorlauf °C"
         }
        },
        "tooltip": {
         "x": {
          "formatter": "EVAL:v => { const b = new Date(); b.setHours(0, 0, 0, 0); return Math.round((v - b.getTime()) / 3600000 - 20) + ' °C'; }"
         }
        },
        "markers": {
         "size": [
          0,
          8
         ]
        },
        "legend": {
         "show": true
        }
       },
       "series": [
        {
         "entity": "number.heating_ochsner_heizkreis_fusspunkt_vorlauftemperatur_heizkurve_03_001",
         "name": "Heizkurve",
         "data_generator": "const b = new Date(); b.setHours(0, 0, 0, 0); const x = t => b.getTime() + (t + 20) * 3600000;const fp = parseFloat(entity.state);const nat = parseFloat(hass.states['number.heating_ochsner_heizkreis_norm_aussentemperatur_heizkurve_03_012'].state);const nvl = parseFloat(hass.states['number.heating_ochsner_heizkreis_vlt_bei_norm_aussentemperatur_heizkurve_03_013'].state);const m = (nvl - fp) / (20 - nat);const pts = []; for (let t = -20; t <= 20; t += 1) pts.push([x(t), +(fp + m * (20 - t)).toFixed(1)]);return pts;",
         "stroke_width": 3,
         "color": "#f5a524",
         "extend_to": false
        },
        {
         "entity": "sensor.heating_ochsner_heizkreis_heizkreis_vorlauftemperatur_sollwert_01_002",
         "name": "jetzt (Soll)",
         "data_generator": "const b = new Date(); b.setHours(0, 0, 0, 0); const x = t => b.getTime() + (t + 20) * 3600000;return [[x(parseFloat(hass.states['sensor.heating_ochsner_anlage_aussentemperatur_00_000'].state)), parseFloat(entity.state)]];",
         "stroke_width": 0,
         "color": "#e5484d",
         "extend_to": false
        }
       ],
       "grid_options": {
        "columns": "full"
       }
      },
      {
       "type": "markdown",
       "content": "{% set fp = states('number.heating_ochsner_heizkreis_fusspunkt_vorlauftemperatur_heizkurve_03_001') | float(20) %}{% set nat = states('number.heating_ochsner_heizkreis_norm_aussentemperatur_heizkurve_03_012') | float(-12) %}{% set nvl = states('number.heating_ochsner_heizkreis_vlt_bei_norm_aussentemperatur_heizkurve_03_013') | float(35) %}{% set at = states('sensor.heating_ochsner_anlage_aussentemperatur_00_000') | float(0) %}{% set m = (nvl - fp) / (20 - nat) %}| Außen | Vorlauf-Soll |\n|---:|---:|\n{% for t in [20, 15, 10, 5, 0, -5, -10, -15] %}| {{ t }} °C | {{ '%.1f' | format(fp + m * (20 - t)) }} °C |\n{% endfor %}\n**Jetzt:** {{ at }} °C außen → Kurve {{ '%.1f' | format(fp + m * (20 - at)) }} °C, Regler-Soll {{ states('sensor.heating_ochsner_heizkreis_heizkreis_vorlauftemperatur_sollwert_01_002') }} °C\n\nSteigung {{ '%.2f' | format(m) }} K pro K",
       "grid_options": {
        "columns": "full"
       }
      }
