       "apex_config": {
        "chart": {
         "height": 280
        },
        "xaxis": {
         "tickAmount": 8,
         "labels": {
          "formatter": "EVAL:v => { const b = new Date(); b.setHours(0, 0, 0, 0); return Math.round((v - b.getTime()) / 3600000 - 20) + ' °C'; }",
          "rotate": 0
